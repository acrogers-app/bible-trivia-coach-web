# Copy to android/keystore.properties and fill in. NEVER commit the real file.
# Keep the keystore itself OUTSIDE this repo (the repo volume is exFAT and
# gathers macOS ._* junk; ~/keystores/ on your home APFS disk is ideal).
#
# Generate the upload keystore yourself (pick your own passwords):
#   keytool -genkeypair -v \
#     -keystore ~/keystores/btc-upload.jks \
#     -alias btc-upload -keyalg RSA -keysize 2048 -validity 10000
storeFile=/Users/YOUR_USER/keystores/btc-upload.jks
storePassword=CHANGE_ME
keyAlias=btc-upload
keyPassword=CHANGE_ME
